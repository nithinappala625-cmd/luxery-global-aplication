# ==============================================================================
# GLOBAL LUXURY MARKETPLACE - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3000
NODE_ENV=development

# 1. Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-confidential
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 2. Cloudflare R2 Media Storage (S3-Compatible)
# CRITICAL: Keep secret keys in NestJS server only. Never expose to client apps.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=luxury-marketplace-assets
R2_PUBLIC_DOMAIN=https://assets.luxurymarketplace.global

# 3. Payments Abstraction Layer
# Razorpay Credentials (Secret key only in NestJS)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PayPal Credentials (Secret key only in NestJS)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
